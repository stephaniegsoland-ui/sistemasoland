SECRET="change_this_secret_key"
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_MODEL="deepseek-chat"
DB_URL="mysql+aiomysql://soland:soland_password@db/soland_db"
DB_URL_DOCKER="mysql+aiomysql://soland:soland_password@db/soland_db"

MYSQL_USER="soland"
MYSQL_PASSWORD="soland_password"
MYSQL_ROOT_PASSWORD="soland_root_password"
MYSQL_DATABASE="soland_db"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"

# Coma separada para permitir peticiones desde otros equipos en la red local
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.50:3000"

# Recuperación de contraseña (SMTP con STARTTLS por defecto)
FRONTEND_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"

# Detector EPP de Roboflow. Entrena el modelo con person, full_body_person
# (solo cuando el cuerpo entero sea visible), face, helmet, safety vest,
# gloves, safety glasses, ear plugs, coveralls y safety boots.
ROBOFLOW_API_KEY=""
# Set this to the Cloud API workflow URL to use a Roboflow Workflow.
ROBOFLOW_WORKFLOW_URL=""
# Optional legacy direct-model endpoint; ignored when ROBOFLOW_WORKFLOW_URL is set.
ROBOFLOW_MODEL_ID="ppe-project/1"
ROBOFLOW_CONFIDENCE_THRESHOLD="0.5"
